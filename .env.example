# Vorlage: kopieren nach .env und Passwort ersetzen
POSTGRES_USER=pea_app
POSTGRES_PASSWORD=HIER_EIN_SICHERES_PASSWORT
POSTGRES_DB=pea_db

DATABASE_URL=postgresql+psycopg://pea_app:HIER_EIN_SICHERES_PASSWORT@localhost:5432/pea_db

# Eigene Datenbank für pytest (wird bei jedem Testlauf neu aufgebaut)
TEST_DATABASE_URL=postgresql+psycopg://pea_app:HIER_EIN_SICHERES_PASSWORT@localhost:5432/pea_test
